rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test document
    match /test/{document=**} {
      allow read: if true;
    }

    // System metadata (e.g. system/meta curriculum version check)
    match /system/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Allow public read to mathTasks for lessons and zadania_matura for simulator
    match /mathTasks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /zadania_matura/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users profile and progress
    match /users/{userId} {
      // Allow authenticated or public reading of profile for arena leaderboard / ranking
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Subcollections like /users/{userId}/progress/math
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Arena multiplayer matches
    match /matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
